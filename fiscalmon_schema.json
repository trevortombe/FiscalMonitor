  },
  "special_cases": {
    "id104_program_expenses": "SYNTHETIC = id103 (prog excl actuarial) + id107 (net actuarial losses). Both values and FY_to_date.",
    "id103_rowid": "9006 always (historical sentinel)",
    "table7_year_percent_change": "Absolute change (this_year - prior_year), NOT a percentage",
    "table7_prior_year": "March 31 start-of-FY balance, not same-month prior year",
    "cash_balance_point_in_time": "id=116 (T1 row15) and id=631 (T6 row15): prior_year=None, this_year=None; values go in prior_FY_to_date and current_FY_to_date",
    "id214_pre_apr2025": "Pollution Pricing Proceeds To Be Returned To Canadians",
    "id214_post_apr2025": "Fuel Charge Proceeds (fuel charge removed April 1 2025)",
    "id344_pre_apr2025": "Pollution Pricing Proceeds Returned To Canadians",
    "id344_post_apr2025": "Fuel Charge Proceeds Returned",
    "table7_omitted_rows": "FX liabilities, derivative liabilities (rows 19-20) and FX assets, derivative assets (rows 24-25) are not stored \u2014 consistent with original dataset",
    "table3_structure_change": "id=313 header, id=781 Health Agreements, id=328 Total Provincial Transfers added in ~2024. Earlier months in dataset may lack these rows.",
    "fy2026_27_dropped_rows": "From 2026m4: id=214 (Fuel Charge Proceeds, T2) and id=309 (COVID-19 income support, T3) no longer published; Finance folded them into Other Revenues (217) and Other Transfer Payments (346), incl. restated prior-year columns. Rows omitted -> 95 rows/month without T7.",
    "id325_post_apr2026": "Build Communities Strong Fund - Community Stream (renamed Canada Community-Building Fund; same series)",
    "id304_label": "Report now labels it 'Old Age Security program'; stored name kept as 'Elderly Benefits'",
    "id344_label_2026_27": "Report again labels it 'Pollution pricing proceeds returned to Canadians'; stored name kept as 'Fuel Charge Proceeds Returned'",
    "combined_apr_may_cash": "Combined Apr+May release (/YYYY/04.html) omits end-of-April cash; derive as end-May cash minus May change in cash (ids 116/631).",
    "dashboard_update": "Append new months to existing DB.data series only (do not regenerate wholesale: dashboard omits some header-only series). Dashboard data now matches the CSV exactly (2003-07 id104 sign fixed 2026-09-27).",
    "historical_backfill_2026_10_03": "2000m1-2007m12 rebuilt against archive/YYYYMMtabN.csv (tab1->T1, tab2->T2, tab3->T3, tab4->T5, tab5->T6, tab6->T7; 200312tab6.xlsx used where no CSV; 200208 tab5/tab6 are swapped in the archive). rowid = line number in the archive file. Combined Apr+May files (200504, 200704) supply both months. Zeros stored as '-'. Log: fiscalmon-backfill-log_2026-10-03.csv; pre-backfill copy: fiscalmon-clean_backup_2026-10-03.csv. fiscalyear column restored to YYYY/YY for all rows.",
    "pre2008_id_conventions": "T3 'Total' lines: transfers to persons=311, support for health and social programs subtotal=322 (only when a second total follows), transfers to other levels of govt=328, subsidies and other transfers=346, crown corporations=361, old-format operating and capital=367. T6 first Total=617, second (after foreign currency)=623.",
    "number_format": "Write values with thousands separators (e.g. \"10,654\"), as in all earlier rows. Months 2025m2-2026m7 had been appended without them; fixed 2026-10-03.",
    "audit_2008_2026_2026_10_03": "Second pass (log: fiscalmon-audit-log_2026-10-03.csv; pre-pass copy: fiscalmon-clean_backup_2026-10-03_pass1.csv). Archive fills 2008-2013; T5 May 2008-2017 FYTD fixed; ids 214/344/328 filled 2024m2-2025m1 and 311/328 2019m4-2020m5 from canada.ca; id 738 merged into 739. Known remaining: T3 ids change meaning across eras (346/347/348/373; 354 vs 365 from 2019m4) - not harmonised.",
    "pdf_2005_10_11": "2005m10 and 2005m11 built from F12-4-2005-10-eng.pdf / F12-4-2005-11-eng.pdf; archive/200510tab1-6.xlsx and 200511tab1-6.xlsx created from them (same layout as other archive files; rowid = row in those files)."
  },
